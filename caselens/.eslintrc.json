{
  "extends": [
    "next/core-web-vitals",
    "next/typescript"
  ],
  "rules": {
    "@typescript-eslint/no-unused-vars": [
      "error",
      {
        "argsIgnorePattern": "^_",
        "varsIgnorePattern": "^_"
      }
    ],
    "@typescript-eslint/no-explicit-any": "error"
  },
  "ignorePatterns": [
    "node_modules",
    ".next",
    "out",
    "tests/e2e",
    "playwright-report",
    "test-results",
    "next-env.d.ts",
    "server/db/migrations"
  ]
}
